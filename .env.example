# Copy this file to .env and fill in your credentials. NEVER commit .env.

# Required DataForSEO API credentials
DATAFORSEO_LOGIN=your_login_here
DATAFORSEO_PASSWORD=your_password_here

# Optional: filter to specific modules (comma-separated, case-insensitive)
# ENABLED_MODULES=SERP,LABS,BACKLINKS

# Optional: filter to specific individual tools
# ENABLED_TOOLS=serp_google_maps_live,labs_google_keyword_ideas

# Optional: Local Falcon integration
# LOCALFALCON_API_KEY=your_localfalcon_api_key
# LOCALFALCON_API_URL=https://custom-url/api
